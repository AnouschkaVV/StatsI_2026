running_total <- function(x) {
out <- numeric(length(x))
total <- 0
for (i in seq_along(x)) {
total <- total +x[i]
out[i] <- total
}
return(out)
}
running_total(c(2, 1, 4))
running_total(c(-2, 5, -1))
running_total(4)
running_total(numeric(0))
