get_grade <- function(mark) {
if (mark >= 50) {
grade <- "II.2"
}
else if (mark >= 60) {
grade <- "II.1"
}
else if (mark >= 70) {
grade <- "I"
}
else {
grade <- "F"
}
return(grade)
}
