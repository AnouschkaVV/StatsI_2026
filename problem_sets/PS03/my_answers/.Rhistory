count_above(x, cutoff =10)
count_above <- (x, cutoff =10)
count_above <- function(x, cutoff =10) {
count <- 0
i <- 1
while (i <= length(x)) {
if (x[i] > cutoff) {
count <- count +1
}
i <- i+1
)
count_above <- function(x, cutoff =10) {
count <- 0
i <- 1
while (i <= length(x)) {
if (x[i] > cutoff) {
count <- count +1
}
i <- i+1
}
return(count)
}
