sum_even <- function(v) {
v <- numeric()
v[1] <- 0
n <- length(v)
for (i in 1:n) {
total <- v[1] + v[i+1]
}
}
sum_even(c(1, 2, 3, 4, 6))
sum_even <- function(v) {
#create separate tracker for the sum, starting at 0
total <- 0
#get number of elements in user's input
n <- length(v)
for (i in 1:n) {
if (v[i] %% 2 == 0) {
total <- total + v[i]
}
}
return(total)
}
